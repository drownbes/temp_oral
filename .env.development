# Local development defaults (checked in, matches process-compose.yaml). Override in .env.
NODE_ENV=development
LOG_LEVEL=info

HTTP_HOST=127.0.0.1
HTTP_PORT=8080

DATABASE_URL=postgres://postgres@127.0.0.1:5432/app

S3_BUCKET=app-dev
S3_ENDPOINT=http://127.0.0.1:7070
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=devaccess
AWS_SECRET_ACCESS_KEY=devsecretkey

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Lets you point sources at a local test server
FETCH_ALLOW_PRIVATE_NETWORKS=true

# The dev worker also serves the sources-browser queue; the Nix shell provides Chromium
BROWSER_FETCH_ENABLED=true

# Fake LLM output, no API key needed. For real summaries set in .env:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
LLM_PROVIDER=stub

# Standard OpenTelemetry SDK variables; production points this at Tempo / an OTel collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
# Tempo takes traces only; metrics (Node SDK and Temporal's) go to VictoriaMetrics
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:8428/opentelemetry/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL=10000

# Notifications only go to the log in development (the notifications context has no real sender)
DIGEST_NOTIFY_RECIPIENT=dev@example.com
